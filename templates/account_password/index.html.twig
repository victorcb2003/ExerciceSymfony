{% extends 'base.html.twig' %}

{% block title %}Changer MDP - Symfocar{% endblock %}

{% block body %}

    <div class="wrapper">
        <h1>Modifier votre mot de passe</h1>
        
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash-{{ label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
        
        <a role="button" href="{{path('app_account')}}" class="btn btn-primary current-btn">Retour a la page compte</a>

        <hr>
        {{ form_start(form) }}
        {{ form_row(form.old_password) }}
        {{ form_row(form.new_password) }}
        {{ form_row(form.submit) }}
        <hr>
    </div>
{% endblock %}


